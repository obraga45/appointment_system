# App (produção: https://temvagas.pt)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessão local (obrigatório em produção se não usar Supabase Auth). Não reutilizar o CRON_SECRET.
SESSION_SECRET="generate-a-long-random-session-secret"

# Supabase Auth (opcional — deixe placeholders para auth local + Postgres Docker)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma / PostgreSQL (Supabase pooler)
# Substitui YOUR-PASSWORD pela password da BD
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Cron (Vercel Cron — rede de segurança)
CRON_SECRET="generate-a-long-random-secret"

# Upstash QStash (lembretes agendados). Sem isto, o cron faz o trabalho.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Upstash Redis (rate limit). Sem isto, usa memória local (só dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (reset de palavra-passe). Sem Resend, tenta WhatsApp se o negócio tiver telemóvel.
RESEND_API_KEY=""
EMAIL_FROM="TemVagas <info@temvagas.pt>"

# Mensagens: evolution | zapi
MESSAGE_PROVIDER="evolution"

# Evolution API — use HTTPS em produção (não HTTP no IP)
EVOLUTION_API_URL="https://whatsapp.temvagas.pt"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="marcaja"
# Secret dedicado do webhook. No Evolution, envie o header x-webhook-secret
# ou acrescente ?webhook_secret=... ao URL. Não use a API key.
EVOLUTION_WEBHOOK_SECRET="generate-a-long-random-webhook-secret"

# Z-API
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
