# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessão local (obrigatório em produção se não usar Supabase Auth)
SESSION_SECRET="generate-a-long-random-session-secret"

# Supabase Auth (opcional — deixe placeholders para auth local + Postgres Docker)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma / PostgreSQL
# Local (docker compose up -d):
DATABASE_URL="postgresql://marcaja:marcaja@localhost:5432/marcaja"
DIRECT_URL="postgresql://marcaja:marcaja@localhost:5432/marcaja"
# Produção Hetzner/Supabase: use o pooler em DATABASE_URL e a ligação directa em DIRECT_URL.

# Cron (Vercel Cron — rede de segurança)
CRON_SECRET="generate-a-long-random-secret"

# Upstash QStash (lembretes agendados). Sem isto, o cron faz o trabalho.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Upstash Redis (rate limit). Sem isto, usa memória local (só dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (reset de palavra-passe). Sem Resend, tenta WhatsApp se o negócio tiver telemóvel.
RESEND_API_KEY=""
EMAIL_FROM="MarcaJá <noreply@localhost>"

# Mensagens: evolution | zapi | twilio
MESSAGE_PROVIDER="evolution"

# Evolution API (Hetzner)
EVOLUTION_API_URL="https://your-evolution-instance.example.com"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="your-instance-name"

# Z-API
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# Twilio (WhatsApp / SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
