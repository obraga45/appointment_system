# URL pública da Evolution (HTTPS; não exponhas a porta 8080 na internet)
SERVER_URL=https://whatsapp.temvagas.pt

# Chave da API Evolution (gera uma longa; a mesma vai para a Vercel em EVOLUTION_API_KEY)
AUTHENTICATION_API_KEY=gera-uma-chave-longa-aqui

# Password interna do Postgres da Evolution (não é a do Supabase)
EVOLUTION_DB_PASSWORD=gera-outra-password-longa

# Webhook para cancelar marcações por WhatsApp.
# No Evolution configura o header x-webhook-secret = EVOLUTION_WEBHOOK_SECRET da Vercel.
# Não coloques o secret na URL.
WEBHOOK_GLOBAL_URL=https://temvagas.pt/api/webhooks/evolution
